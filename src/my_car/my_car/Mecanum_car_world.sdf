<?xml version="1.0"?>
<sdf version="1.9">
  <world name="car_world">

    <!-- ==================== 物理引擎设置 ==================== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quickstep</type>
          <iters>100</iters>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== 世界级系统插件 ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- ==================== 传感器系统插件 ==================== -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 四周墙壁 ==================== -->
    <model name="wall_south">
      <static>true</static>
      <pose>3.0 -1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>3.0 7.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>7.0 3.0 0.2 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-1.0 3.0 0.2 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.1 0.4</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 圆柱体障碍物 ==================== -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>1.0 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0 0 0.5 1</ambient><diffuse>0 0 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_2">
      <static>true</static>
      <pose>1.0 1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0 0 0.5 1</ambient><diffuse>0 0 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_big">
      <static>true</static>
      <pose>3.0 3.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>1.0</radius><length>0.4</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.0</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0 1</ambient><diffuse>0.9 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 太阳光 ==================== -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.5 -1</direction>
    </light>

    <!-- ==================== Mecanum 小车 ==================== -->
    <model name="diff_car" xmlns:ignition="http://ignitionrobotics.org/schema">
      <pose>0 0 0.10 0 0 0</pose>

      <!-- ==================== 车身 ==================== -->
      <link name="chassis">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00416667</ixx>
            <iyy>0.01416667</iyy>
            <izz>0.01666667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.2 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0 0 0.5 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
      </link>

      <!-- ==================== 车头标记 ==================== -->
      <link name="head_marker">
        <pose>0.22 0 0.02 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="head_marker_joint" type="fixed">
        <parent>chassis</parent>
        <child>head_marker</child>
      </joint>

      <!-- ============ 左前轮（辊子 +45° → fdir1 = (1,-1,0)） ============ -->
      <link name="front_left_wheel">
        <pose>0.15 0.115 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <!-- 辊子近似：沿 fdir1 有摩擦（驱动方向），垂直方向 mu2≈0（可自由横滑） -->
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.5 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse></material>
        </visual>
        <!-- 辊子不再用刚性固定的球体表示（球体没有朝向，45° 无意义），改由上面的 fdir1 各向异性摩擦近似 -->
      </link>
      <joint name="front_left_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- ============ 右前轮（辊子 -45° → fdir1 = (1,1,0)） ============ -->
      <link name="front_right_wheel">
        <pose>0.15 -0.115 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <!-- 辊子近似：沿 fdir1 有摩擦（驱动方向），垂直方向 mu2≈0（可自由横滑） -->
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0 0.4 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
        </visual>
        <!-- 辊子不再用刚性固定的球体表示（球体没有朝向，45° 无意义），改由上面的 fdir1 各向异性摩擦近似 -->
      </link>
      <joint name="front_right_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- ============ 左后轮（辊子 -45° → fdir1 = (1,1,0)） ============ -->
      <link name="back_left_wheel">
        <pose>-0.15 0.115 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <!-- 辊子近似：沿 fdir1 有摩擦（驱动方向），垂直方向 mu2≈0（可自由横滑） -->
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.5 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="back_left_joint" type="revolute">
        <parent>chassis</parent>
        <child>back_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- ============ 右后轮（辊子 +45° → fdir1 = (1,-1,0)） ============ -->
      <link name="back_right_wheel">
        <pose>-0.15 -0.115 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <!-- 辊子近似：沿 fdir1 有摩擦（驱动方向），垂直方向 mu2≈0（可自由横滑） -->
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0 0.4 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="back_right_joint" type="revolute">
        <parent>chassis</parent>
        <child>back_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- ==================== 万向轮 ==================== -->
      <link name="caster_wheel">
        <pose>0 0 -0.03 0 0 0</pose>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>0.0000032</ixx><iyy>0.0000032</iyy><izz>0.0000032</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster_wheel</child>
      </joint>

      <!-- ==================== 激光雷达 ==================== -->
      <link name="lidar_link">
        <pose>0 0 0.07 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <gz_frame_id>lidar_link</gz_frame_id>
          <pose>0 0 0.02 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.10</min>
              <!-- max 必须写！sdformat 里 range/max 默认是 0，缺了它 gpu_lidar
                   会把 720 个点全部报成 range_min（实测全是 0.1m），建图完全废掉。 -->
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
      </joint>

      <!-- ==================== MecanumDrive 插件 ==================== -->
      <plugin
        filename="gz-sim-mecanum-drive-system"
        name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_joint</front_left_joint>
        <front_right_joint>front_right_joint</front_right_joint>
        <back_left_joint>back_left_joint</back_left_joint>
        <back_right_joint>back_right_joint</back_right_joint>
        <wheel_radius>0.05</wheel_radius>
        <wheel_separation>0.23</wheel_separation>
        <wheelbase>0.30</wheelbase>
        <topic>/cmd_vel</topic>
        <!-- 这里原本还写了 <odom_topic>/<tf_topic>/<frame_id>/<child_frame_id>/
             <odom_publish_frequency>/<max_linear_velocity>/<max_angular_velocity>，
             但 Fortress 6.18 的这个插件只会把 /odom、/tf 话题广告出来，一条消息
             都不发（官方 mecanum_drive.sdf 也是 0 条，实测），SLAM 拿不到
             odom->base_footprint。所以里程计交给下面的 OdometryPublisher 发，
             这几个参数留着只会误导人，删掉。 -->
      </plugin>

      <!-- ==================== 里程计 / TF 发布 ==================== -->
      <!-- MecanumDrive 发不出 odom，用 OdometryPublisher 补上（位置取自模型的
           世界位姿，dimension=2 表示只发 x/y/yaw、z 恒 0，正好对应地面投影点
           base_footprint）。frame_id / child_frame_id 必须和 car_world.launch.py
           里的桥接 + 静态 TF 对得上：/odom 与 /tf 都是 odom -> base_footprint。 -->
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimension>2</dimension>
      </plugin>

    </model>
  </world>
</sdf>