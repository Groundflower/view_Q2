<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 世界名称：car_world -->
  <world name="car_world">

    <!-- ==================== 物理引擎设置 ==================== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quickstep</type>
          <iters>100</iters>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== 世界级系统插件（必须！） ==================== -->
    <!-- 没有这几个系统，仿真只会“空转”：物理引擎不会被创建/步进，
         DiffDrive 不会发里程计也不会给轮子下发速度 —— 小车完全不动，
         且没有 SceneBroadcaster，GUI / /world/car_world/... 都是空的。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- ==================== 传感器系统插件（世界级！） ==================== -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 四周墙壁 ==================== -->
    <!-- 矩形区域：(-1,-1) → (7,-1) → (7,7) → (-1,7) -->

    <!-- 南墙 -->
    <model name="wall_south">
      <static>true</static>
      <pose>3.0 -1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 北墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>3.0 7.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 东墙 -->
    <model name="wall_east">
      <static>true</static>
      <pose>7.0 3.0 0.2 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 西墙 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-1.0 3.0 0.2 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8.0 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 圆柱体障碍物 ==================== -->

    <model name="cylinder_1">
      <static>true</static>
      <pose>1.0 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.4</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0 0.5 1</ambient>
            <diffuse>0 0 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cylinder_2">
      <static>true</static>
      <pose>1.0 1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.4</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0 0.5 1</ambient>
            <diffuse>0 0 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 大圆柱体 -->
    <model name="cylinder_big">
      <static>true</static>
      <pose>3.0 3.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.0</radius><length>0.4</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.0</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.3 0 1</ambient>
            <diffuse>0.9 0.5 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 太阳光 ==================== -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.5 -1</direction>
    </light>

    <!-- ==================== 差速小车 ==================== -->
    <model name="diff_car">
      <pose>0 0 0.10 0 0 0</pose>

      <!-- 车身底盘 -->
      <link name="chassis">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00416667</ixx>
            <iyy>0.01416667</iyy>
            <izz>0.01666667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.2 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0 0 0.5 1</ambient>
            <diffuse>0 0 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 左轮 -->
      <link name="left_wheel">
        <pose>-0.1 0.125 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0 0 1</ambient>
            <diffuse>0.9 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- 右轮 -->
      <link name="right_wheel">
        <pose>-0.1 -0.125 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006875</ixx><iyy>0.000125</iyy><izz>0.00006875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.4 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="right_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100000</lower><upper>100000</upper></limit>
          <dynamics><damping>0.05</damping><friction>0</friction></dynamics>
        </axis>
      </joint>

      <!-- 前支撑万向轮 -->
      <link name="caster_wheel">
        <pose>0.16 0 -0.08 0 0 0</pose>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>0.0000032</ixx><iyy>0.0000032</iyy><izz>0.0000032</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.02</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.02</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster_wheel</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <!-- ==================== 激光雷达 Link（传感器放在这里面！） ==================== -->
      <link name="lidar_link">
        <pose>0 0 0.07 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.04</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.04</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <!-- ★★★ 传感器必须放在 <link> 里面！ ★★★ -->
        <sensor name="lidar" type="gpu_lidar">
          <!-- 消息里的 frame_id，默认会是 diff_car::lidar_link::lidar，
               在 ROS 里很难用，这里改成 lidar_link -->
          <gz_frame_id>lidar_link</gz_frame_id>
          <pose>0 0 0.02 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.10</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <!-- ==================== 差速驱动插件 ==================== -->
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_radius>0.05</wheel_radius>
        <wheel_separation>0.25</wheel_separation>
        <topic>/cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <!--
          DiffDrive 发布的 TF 是纯 2D 里程计位姿（只有 x / y / yaw，z 恒为 0），
          语义上就是"车体在地面上的投影点"，所以这个 child frame 应该直接叫
          base_footprint：它是 odom 唯一的子坐标系，而一个坐标系只能有一个父，
          想让 base_footprint 出现在 TF 树里就只能占这个位置。
          车体中心 chassis 则由 launch 里的静态变换挂在 base_footprint 下面。
        -->
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>2.0</max_linear_velocity>
        <max_angular_velocity>4.0</max_angular_velocity>
      </plugin>

    </model>
  </world>
</sdf>